{
  "name": "mamori",
  "version": "0.3.0",
  "private": true,
  "description": "A small, self-hosted identity provider for teams of 10-100",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js",
    "admin": "node dist/cli.js"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3",
    "oidc-provider": "9.13.3",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/oidc-provider": "9.13.1",
    "openid-client": "6.8.8",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "bin": {
    "mamori-admin": "dist/cli.js"
  }
}
