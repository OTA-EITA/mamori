{
  "name": "mamori",
  "version": "0.0.0",
  "private": true,
  "description": "A small, self-hosted identity provider for teams of 10-100",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "oidc-provider": "9.13.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "openid-client": "6.8.8",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
